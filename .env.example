# Copy to .env.local. See docs/tdd.md §17. Server-only unless prefixed NEXT_PUBLIC_.

# Supabase (local: values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zernio. SOCIAL_PROVIDER_MODE=mock keeps signup, connect and sends in-process (no Zernio
# calls; CLAUDE.md rule 14). Default: mock under Vitest, zernio otherwise. Refused in production.
SOCIAL_PROVIDER_MODE=
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Jev (docs/tdd.md §9). JEV_API_URL is the full endpoint URL:
#   local jevos     http://127.0.0.1:8017/v1/systemone
#   TypeSafe cloud  https://api.typesafe.ai/v1/systemone
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=3000
# USD per million input tokens (cloud 0.042; local jevos 0). Output tokens are free.
JEV_COST_PER_MTOK_INPUT=0
# Triage report only: extra Jev endpoints to compare, name=url,... (key: JEV_API_KEY_<NAME>).
TRIAGE_JEV_ENDPOINTS=

# LLM via OpenRouter + Vercel AI SDK (docs/tdd.md §10). Models are "provider/model" ids.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Free local testing ($0, 20 req/min, 50/day without purchased credits):
#   LLM_CLASSIFY_MODEL / LLM_DRAFT_MODEL=nvidia/nemotron-3.5-super-vl:free
#   EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free (asked for 1536 dims)
LLM_CLASSIFY_MODEL=
LLM_DRAFT_MODEL=
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
# Relevance floor for Business info search (T31, 0 to 1). Unset: 0.25, tuned for the free nvidia
# embedding model; retune when EMBEDDING_MODEL changes.
KB_MIN_SIMILARITY=

# Email
# Owner alerts (T13). Without both, alerts are logged instead of emailed.
# ALERT_FROM_EMAIL e.g. "Receptionist <alerts@yourdomain.com>" (a domain verified in Resend).
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# Platform problems (Zernio paused for billing, T19) go to the operator, never to owners.
OPERATOR_ALERT_EMAIL=
# Admin pages (/admin/lab, /admin/costs) need the operator role on the login (app_metadata, T34):
# pnpm local:operator --email you@x. There is no email list any more.

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Jobs: pg_cron sends Authorization: Bearer $CRON_SECRET to /api/jobs/process. The same value
# and the route URL live in Supabase Vault (cron_secret, job_process_url). Local: local-dev-cron-secret
# (supabase/seed.sql).
CRON_SECRET=

# Sentry (also exposed to the client as NEXT_PUBLIC_SENTRY_DSN via next.config.ts)
SENTRY_DSN=

APP_URL=http://localhost:3000

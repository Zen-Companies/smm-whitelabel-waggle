# Copy to .env.local. See docs/tdd.md §17. Server-only unless prefixed NEXT_PUBLIC_.

# Supabase (local: values printed by `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zernio
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Jev (docs/tdd.md §9). JEV_API_URL is the full endpoint URL:
#   local jevos     http://127.0.0.1:8017/v1/systemone
#   TypeSafe cloud  https://api.typesafe.ai/v1/systemone
JEV_API_URL=
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=3000
# USD per million input tokens (cloud 0.042; local jevos 0). Output tokens are free.
JEV_COST_PER_MTOK_INPUT=0
# Triage report only: extra Jev endpoints to compare, name=url,... (key: JEV_API_KEY_<NAME>).
TRIAGE_JEV_ENDPOINTS=

# LLM via OpenRouter + Vercel AI SDK (docs/tdd.md §10). Models are "provider/model" ids.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_CLASSIFY_MODEL=
LLM_DRAFT_MODEL=
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small

# Email
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Jobs: pg_cron sends Authorization: Bearer $CRON_SECRET to /api/jobs/process. The same value
# and the route URL live in Supabase Vault (cron_secret, job_process_url). Local: local-dev-cron-secret
# (supabase/seed.sql).
CRON_SECRET=

# Sentry (also exposed to the client as NEXT_PUBLIC_SENTRY_DSN via next.config.ts)
SENTRY_DSN=

APP_URL=http://localhost:3000

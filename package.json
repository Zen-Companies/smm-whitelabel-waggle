{
  "name": "ai-receptionist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "supabase test db",
    "gen:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "triage:report": "tsx --tsconfig tsconfig.scripts.json scripts/triage-report.ts",
    "draft:preview": "tsx --tsconfig tsconfig.scripts.json scripts/draft-preview.ts",
    "draft:check": "tsx --tsconfig tsconfig.scripts.json scripts/draft-check.ts",
    "local:owner": "tsx --tsconfig tsconfig.scripts.json scripts/local-owner.ts",
    "local:operator": "tsx --tsconfig tsconfig.scripts.json scripts/local-operator.ts",
    "demo:seed": "tsx --tsconfig tsconfig.scripts.json scripts/demo-seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@sentry/nextjs": "^11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@zernio/node": "0.2.1369",
    "ai": "7.0.155",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.30.3"
}
